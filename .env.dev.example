# Local development environment.
# Copy to .env: cp .env.dev.example .env — never commit .env.

DEBUG=True
SECRET_KEY=dev-only-insecure-secret-key-change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL). These localhost URLs are for running Django
# directly on your machine against a local Postgres/Redis. If you use
# `docker compose up` instead, docker-compose.override.yml overrides both
# with the in-network service names (db/redis) automatically — you don't
# need to edit these for Docker.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/marketplace

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# S3-compatible object storage — leave blank in dev to fall back to local
# filesystem storage under media/.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_ENDPOINT_URL=

# Razorpay sandbox/test keys — https://dashboard.razorpay.com/app/keys (test mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
