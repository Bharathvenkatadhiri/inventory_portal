# Production environment template.
# Copy to .env on the server (or set these as real env vars/secrets in your
# hosting platform): cp .env.prod.example .env — then fill in every value
# below. Never commit .env, and never reuse the dev SECRET_KEY/DB password.
#
# Unlike dev, docker-compose.prod.yml does NOT bundle a Postgres/Redis
# container — point these at managed instances (RDS/Cloud SQL/managed
# Redis/etc.). Running your own stateful DB/Redis containers in production
# is avoidable complexity for a small team; use a managed service instead.

DEBUG=False
# Generate a real one, e.g.: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Your real domain(s), comma-separated. No localhost/testserver in production.
ALLOWED_HOSTS=example.com,www.example.com

# Optional: override the default log level (INFO by default since DEBUG=False).
# LOG_LEVEL=INFO
# DJANGO_LOG_LEVEL=WARNING

# Managed PostgreSQL connection string.
DATABASE_URL=postgres://user:password@your-db-host:5432/marketplace

# Managed Redis connection string (used for both Celery broker/result backend).
REDIS_URL=redis://your-redis-host:6379/0

# S3-compatible object storage — required in production (no local-disk
# fallback across multiple app instances/deploys).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_ENDPOINT_URL=

# Razorpay LIVE keys — https://dashboard.razorpay.com/app/keys (live mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
