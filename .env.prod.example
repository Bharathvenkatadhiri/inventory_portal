# Production environment template.
# Copy to .env on the server (or set these as real env vars/secrets in your
# hosting platform): cp .env.prod.example .env — then fill in every value
# below. Never commit .env, and never reuse the dev SECRET_KEY/DB password.
#
# Unlike dev, docker-compose.prod.yml does NOT bundle a Postgres container —
# point this at a managed instance (RDS/Cloud SQL/etc.). Running your own
# stateful DB container in production is avoidable complexity for a small
# team; use a managed service instead.

DEBUG=False
# Generate a real one, e.g.: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Your real domain(s), comma-separated. No localhost/testserver in production.
ALLOWED_HOSTS=example.com,www.example.com

# Optional: override the default log level (INFO by default since DEBUG=False).
# LOG_LEVEL=INFO
# DJANGO_LOG_LEVEL=WARNING

# Managed PostgreSQL connection string.
DATABASE_URL=postgres://user:password@your-db-host:5432/marketplace

# S3-compatible object storage — required in production (no local-disk
# fallback across multiple app instances/deploys).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_ENDPOINT_URL=

# GST verification (company registration). Set GST_VERIFICATION_PROVIDER to
# a real provider registered in accounts/services/gst_verification.py's
# get_provider() and fill in its credentials — never commit them.
GST_VERIFICATION_PROVIDER=mock
GST_VERIFICATION_API_KEY=
GST_VERIFICATION_API_BASE_URL=
GST_VERIFICATION_TIMEOUT_SECONDS=10

# Web server (see gunicorn.conf.py). Each worker thread can hold one
# database connection, so GUNICORN_WORKERS x GUNICORN_THREADS must stay
# below your managed Postgres connection limit (defaults: up to 5 x 4 = 20).
# GUNICORN_WORKERS=5
# GUNICORN_THREADS=4
# GUNICORN_TIMEOUT=60

# Seconds to keep a database connection open for reuse (0 = new connection
# per request).
# DB_CONN_MAX_AGE=60

# Shared cache for all web workers. Defaults to the database cache
# (dbcache://django_cache — the prod start command creates its table).
# For Redis: CACHE_URL=redis://your-redis-host:6379/1 and add `redis` to
# requirements.txt.
# CACHE_URL=dbcache://django_cache

# Email (password reset, etc). Required in production — defaults to the SMTP
# backend since DEBUG=False. Point at your transactional email provider.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=ManufactureHub <no-reply@example.com>
