# Test/staging environment template, for the EC2-hosted test site deployed
# with docker-compose.test.yml (bundled Postgres + nginx, local-disk media
# instead of S3). Copy to .env on the server: cp .env.test.example .env —
# then fill in every value below. Never commit .env.
#
# This is NOT the production template — see .env.prod.example for a real
# deployment (managed DB, S3, HTTPS via a real load balancer/certificate).
# Don't reuse this test site's SECRET_KEY/DB password anywhere else.

DEBUG=False
# Generate a real one, e.g.: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=GDgzGlm1HnZwWeGLzU_-qFEFJUJr44GcL4kDNZq_GFQjEJkrKd761EBwr3Ru57LURYU
# The EC2 instance's public IP or DNS name (whatever you'll type into the
# browser), comma-separated if you have more than one.
ALLOWED_HOSTS=test.makesetu.in

# Absolute base URL used in links sent by email (order/RFQ notifications).
# core/settings.py would otherwise default this to an https:// URL (since
# DEBUG=False) which is wrong for this plain-HTTP test site.
SITE_URL=https://test.makesetu.in

# Postgres password for the bundled db container (docker-compose.test.yml
# reads this too — it's passed through to both the db and web services).
POSTGRES_PASSWORD=Srithvik@260724

# --- HTTPS / cookies ---------------------------------------------------------
# This stack's nginx (nginx/test.conf) terminates plain HTTP only — no
# certificate. DEBUG=False normally turns on HTTPS redirects and Secure
# cookies, which would break login over plain HTTP, so all of that is
# switched off here. If you later put a real domain + TLS certificate in
# front of this box, delete this block and follow .env.prod.example's HTTPS
# section instead.
SECURE_SSL_REDIRECT=False
SECURE_PROXY_SSL_HEADER=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# Optional: override the default log level (INFO by default since DEBUG=False).
# LOG_LEVEL=INFO
# DJANGO_LOG_LEVEL=WARNING

# docker-compose.test.yml overrides this to point at the bundled db
# container — you don't need to edit it for Docker.
DATABASE_URL=postgres://makesetu_app:${POSTGRES_PASSWORD}@db:5432/makesetu

# Media storage: local disk instead of S3 for this disposable test site
# (nginx serves /media/ straight off the shared volume — see nginx/test.conf).
# core/settings.py normally refuses to start with DEBUG=False and no S3
# bucket, specifically to stop a real deployment from serving uploads
# unsigned; ALLOW_LOCAL_MEDIA_STORAGE opts this test site out of that check.
# Never set this on the real production site.
ALLOW_LOCAL_MEDIA_STORAGE=True

# GST verification (company registration). Leave as "mock" for testing — no
# external calls, deterministic results.
GST_VERIFICATION_PROVIDER=mock
GST_VERIFICATION_API_KEY=
GST_VERIFICATION_API_BASE_URL=
GST_VERIFICATION_TIMEOUT_SECONDS=10

# Email (OTP verification, password reset, etc). Defaults to the console
# backend so the test site needs no SMTP setup — codes/links show up in
# `docker compose -f docker-compose.test.yml logs web` instead of being
# emailed. Uncomment and fill these in if you want real emails sent instead.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=MakeSetu <no-reply@makesetu.com>
