# Local development environment.
# Copy to .env: cp .env.dev.example .env — never commit .env.

DEBUG=True
SECRET_KEY=dev-only-insecure-secret-key-change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional: override the default log level (defaults to DEBUG when DEBUG=True,
# INFO otherwise). DJANGO_LOG_LEVEL controls Django's own internal logger
# (requests, DB, etc.) separately from LOG_LEVEL, which is the root logger
# used by our own app code (e.g. marketplace.views, core.backends).
# LOG_LEVEL=DEBUG
# DJANGO_LOG_LEVEL=INFO

# Database (PostgreSQL). This localhost URL is for running Django directly
# on your machine against a local Postgres. If you use `docker compose up`
# instead, docker-compose.yml overrides it with the in-network service name
# (db) automatically — you don't need to edit this for Docker.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/marketplace

# S3-compatible object storage — leave blank in dev to fall back to local
# filesystem storage under media/.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_ENDPOINT_URL=

# GST verification (company registration). Leave as "mock" in dev — no
# external calls, deterministic results. Never commit real credentials.
GST_VERIFICATION_PROVIDER=mock
GST_VERIFICATION_API_KEY=
GST_VERIFICATION_API_BASE_URL=
GST_VERIFICATION_TIMEOUT_SECONDS=10

# Email (password reset, etc). Defaults to the console backend in dev —
# emails print to the runserver log instead of actually sending. Leave blank.
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=ManufactureHub <no-reply@manufacturehub.example>
